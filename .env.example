# Copy to .env.local and fill in. Never commit real keys.

# Anthropic (claim extraction + judging)
ANTHROPIC_API_KEY=

# Firecrawl (web evidence search)
FIRECRAWL_API_KEY=
# Set to false to use search snippets only (cheaper, weaker evidence)
FIRECRAWL_SCRAPE_RESULTS=true

# Flagsmith (self-hosted). Use the environment's server-side or client-side key.
FLAGSMITH_API_URL=https://ashish-soni08--flagops-flagsmith-serve.us-east.modal.run/api/v1/
FLAGSMITH_ENVIRONMENT_KEY=
FLAGSMITH_TIMEOUT_SECONDS=5

# FlagOps metrics ingest (one JSON event per request). Leave empty to disable.
FLAGOPS_INGEST_URL=
FLAGOPS_INGEST_TOKEN=
FLAGOPS_ENVIRONMENT=development
# Also print each event to the server log
FLAGOPS_LOG_EVENTS=false
